# ===== 数据库 =====
# 本地开发默认 SQLite；生产使用 PostgreSQL：
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/trip
DATABASE_URL=sqlite:///./trip.db

# ===== Redis（Celery 任务队列 broker）=====
REDIS_URL=redis://localhost:6379/0

# ===== LLM（DeepSeek / OpenAI 兼容）=====
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.7

# ===== 高德地图官方 MCP 服务 =====
# Web 服务 API key，后端以 stdio 方式拉起官方 MCP 服务器
# （@amap/amap-maps-mcp-server，需 Node.js 环境），key 通过 AMAP_MAPS_API_KEY 注入。
AMAP_API_KEY=your-amap-web-api-key

# ===== Unsplash 图片服务（可选）=====
UNSPLASH_ACCESS_KEY=

# ===== JWT =====
# 生成强密钥：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== 可观测性：Langfuse 链路追踪（可选，默认关闭）=====
# 开启后，每次行程生成会在 Langfuse 上留下 gather→plan→enrich 的 trace。
# 最快路径：在 https://cloud.langfuse.com 注册项目，填下面三项并设 LANGFUSE_ENABLED=true。
# 自托管：把 LANGFUSE_HOST 指向自己的 Langfuse 实例（见 docker-compose.langfuse.yml）。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 服务器 =====
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
