# =============================================================================
# 环境变量模板 —— 复制为 backend/.env 后填写真实值。
#
# 本文件只放占位符（your-xxx-key / please-change-me），严禁把真实密钥写进这里：
# 真实值只写在 backend/.env（已被 .gitignore 忽略，不会进入版本库）。
# 这是本地开发用模板；docker-compose 部署用项目根目录的 .env.example。
# =============================================================================

# ===== 数据库（本地开发 PostgreSQL）=====
# 本机需已启动 PostgreSQL，密码换成你自己的，库名 tripdb。
DATABASE_URL=postgresql+psycopg2://postgres:your-password@localhost:5432/tripdb

# ===== Redis（Celery 任务队列 broker）=====
REDIS_URL=redis://localhost:6379/0

# ===== LLM（DeepSeek / OpenAI 兼容）=====
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.7

# ===== 高德地图官方 MCP 服务 =====
# Web 服务 API key，后端以 stdio 方式拉起官方 MCP 服务器
# （@amap/amap-maps-mcp-server，需 Node.js 环境），key 通过 AMAP_MAPS_API_KEY 注入。
AMAP_API_KEY=your-amap-web-api-key

# ===== Unsplash 图片服务（可选）=====
UNSPLASH_ACCESS_KEY=

# ===== JWT =====
# 必改：生成强密钥 python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 限流（slowapi）=====
RATE_LIMIT_GENERATE=5/minute

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== 可观测性：Langfuse 链路追踪（可选，默认关闭）=====
# 开启后，每次行程生成会在 Langfuse 上留下 gather→plan→enrich 的 trace。
# 最快路径：在 https://cloud.langfuse.com 注册项目，填下面三项并设 LANGFUSE_ENABLED=true。
# 自托管：把 LANGFUSE_HOST 指向自己的 Langfuse 实例（见 docker-compose.langfuse.yml）。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 服务器 =====
HOST=0.0.0.0
PORT=8000
# 热重载开关：本地开发 true；生产/容器用 uvicorn 直启，无需热重载
RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
