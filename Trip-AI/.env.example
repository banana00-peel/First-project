# =============================================================================
# docker-compose 部署用环境变量模板 —— 复制为项目根目录 .env 后填写真实值。
# 只放占位符，严禁提交真实密钥；真实值只写在根目录 .env（已被 .gitignore 忽略）。
# 注意：这是给 docker-compose 的；本地开发用的是 backend/.env（模板见 backend/.env.example）。
# =============================================================================
LLM_API_KEY=your-deepseek-api-key
AMAP_API_KEY=your-amap-web-api-key
UNSPLASH_ACCESS_KEY=
JWT_SECRET=please-change-me
# 生产必改强密码（数据库密码从环境变量注入，不写死在编排文件里）
POSTGRES_PASSWORD=please-change-me
CORS_ORIGINS=http://localhost
